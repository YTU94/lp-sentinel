  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".tsbuild/node"
  },
  "include": ["api", "server", "shared", "vite.config.ts", "vitest.config.ts"]
}
