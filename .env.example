# Optional RPC overrides
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Browser-side wallet preflight RPC. Use a public URL; never put a private credential in VITE_* variables.
VITE_BSC_RPC_URL=https://bsc-rpc.publicnode.com

# Optional wallet NFT discovery
BSCSCAN_API_KEY=

# Vercel/server-side DingTalk OpenAPI alerts. Never prefix these with VITE_.
# DINGTALK_USER_IDS accepts up to 20 enterprise user IDs separated by commas.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_USER_IDS=
# Random 32+ character bearer token required by Vercel refresh requests.
LP_SENTINEL_MONITOR_TOKEN=

# Local runtime
LP_SENTINEL_PORT=4317
LP_SENTINEL_DATA=data/lp-sentinel.json
