# 默认规则模式不需要模型凭据。启用模型后只发送脱敏行情与决策摘要。
AI_GATEWAY_API_KEY=
# 使用 AI Gateway 中支持工具调用的 provider/model 标识。
LP_AGENT_MODEL=
# 地址驱动的 AI 分析默认复用本机 codex login 状态。
LP_PORTFOLIO_AI_PROVIDER=codex
# 本机 Codex CLI 路径，可用于 GUI 启动器的受控调用。
# LP_CODEX_BIN=/absolute/path/to/codex
# 可选的多链 RPC；仅配置当前网络策略允许访问的节点。
# ETHEREUM_RPC_URL=
# ARBITRUM_RPC_URL=
# OPTIMISM_RPC_URL=
# BASE_RPC_URL=
# BSC_RPC_URL=
# ROBINHOOD_RPC_URL=
# 每日有效区间回放优先采用对应历史节点，需要历史 eth_call、eth_getLogs 和交易收据。
# BASE_HISTORY_RPC_URL=
# ETHEREUM_HISTORY_RPC_URL=
# OPTIMISM_HISTORY_RPC_URL=
# ARBITRUM_HISTORY_RPC_URL=
# BSC_HISTORY_RPC_URL=
# ROBINHOOD_HISTORY_RPC_URL=
# 可选：使用独立数据文件进行演练，避免读取日常监控仓位。
# LP_SENTINEL_DATA_FILE=/tmp/lp-agent-demo.json
# 仅供离线 Uniswap 历史研究使用；通过 Authorization header 发送，不写入数据文件。
THE_GRAPH_API_KEY=
